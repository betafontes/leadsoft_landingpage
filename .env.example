# ============================================
# LeadSoft Landing Page — Environment Variables
# ============================================

# Backend (Fastify)
API_HOST=0.0.0.0
API_PORT=3001

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# RavenDB
RAVENDB_URL=http://localhost:8080
RAVENDB_DATABASE=LeadSoftDB

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-long
JWT_EXPIRES_IN=8h

# Google reCAPTCHA v3
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Upload
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
REQUIRED_IMAGE_WIDTH=1080
REQUIRED_IMAGE_HEIGHT=1080

# Admin Seed
ADMIN_EMAIL=LeadIA@leadsoft.inf.br
ADMIN_PASSWORD=Lead@1234

# CORS
CORS_ORIGIN=http://localhost:3000
